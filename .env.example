# Sanity project — used by the embedded Studio (sanity.config.ts)
PUBLIC_SANITY_PROJECT_ID=h1krgjqa
PUBLIC_SANITY_DATASET=production

# Shared secret to enter draft preview mode. Generate any random string
# (e.g. `openssl rand -hex 16`) and use the same value here and in the
# Studio's "Aperçu sur le site" action.
PUBLIC_SANITY_PREVIEW_SECRET=

# Sanity API token with read access (Viewer role is enough), used
# server-side only to fetch draft content in preview mode.
# Create it at https://www.sanity.io/manage > project > API > Tokens
SANITY_API_READ_TOKEN=

# Secret checked by the /api/revalidate webhook.
SANITY_REVALIDATE_SECRET=
