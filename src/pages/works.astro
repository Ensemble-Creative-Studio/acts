---
import HomepageIntroSlide from "../components/homepage/HomepageIntroSlide.astro";
import HomepageProjectSlide from "../components/homepage/HomepageProjectSlide.astro";
import type { GallerySlide, PresentationSlide, Project } from "../components/homepage/types";
import Layout from "../layouts/Layout.astro";
import { getHomepage } from "../sanity/lib/sanity-utils";

const homepage = await getHomepage(Astro.locals.preview);

const galleries = homepage?.galleries ?? [];

// Keep project slides, and only the presentation/divider slides that carry
// a subtitle (e.g. "Selected work — Projects produced by Iman Delimi..."),
// which mark a real distinction between groups of projects. Drop the plain
// "Project by [[logo]]" opener, which is just a homepage decoration.
const slides = galleries
  .flatMap((gallery) => gallery.slides)
  .filter(
    (slide: GallerySlide) =>
      slide._type === "project" ||
      (slide._type === "homepageGalleryPresentationSlide" &&
        (slide as PresentationSlide).subtitle),
  );
---

<Layout
  title={homepage?.seo?.seoTitle ? `Works — ${homepage.seo.seoTitle}` : "Works"}
  description={homepage?.seo?.seoDescription}
  image={homepage?.seo?.seoImage}
>
  <main class="h-dvh overflow-y-auto overscroll-y-contain snap-y snap-mandatory text-neutral-950">
    {slides.length ? (
      slides.map((slide) =>
        slide._type === "homepageGalleryPresentationSlide" ? (
          <HomepageIntroSlide slide={slide as PresentationSlide} />
        ) : (
          <HomepageProjectSlide slide={slide as Project} />
        ),
      )
    ) : (
      <section
        class="flex min-h-dvh snap-start items-center justify-center px-6"
        data-page-background="#EDDDD9"
      >
        <div class="max-w-md text-center">
          <p class="text-pretty text-base text-neutral-600">
            Ajoutez des projets dans les galleries de la Homepage sur Sanity pour remplir cette page.
          </p>
        </div>
      </section>
    )}
  </main>
</Layout>

<script>
  import { initPageBackgroundColorSync } from "../scripts/page-backgroundcolor-sync";
  import {
    initProjectCardInteractions,
    initGlobalVideoMuteGuard,
  } from "../scripts/project-card-interactions";

  initProjectCardInteractions();
  initGlobalVideoMuteGuard();
  initPageBackgroundColorSync();
</script>
