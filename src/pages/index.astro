---
import HomepageIntroSlide from "../components/homepage/HomepageIntroSlide.astro";
import HomepageProjectSlide from "../components/homepage/HomepageProjectSlide.astro";
import HeroSlide from "../components/homepage/HeroSlide.astro";
import FooterSlide from "../components/homepage/FooterSlide.astro";
import PortableText from "../components/PortableText.astro";
import type {
  PresentationSlide,
  Project,
} from "../components/homepage/types";
import Layout from "../layouts/Layout.astro";
import { getEvents, getHomepage } from "../sanity/lib/sanity-utils";

const heroSeenStorageKey = "homepage-hero-animation-seen";
const homepage = await getHomepage(Astro.locals.preview);
const eventsData = await getEvents(Astro.locals.preview);

const galleries = (homepage?.galleries ?? []).slice(0, 2);
const slides = galleries.flatMap((gallery) => gallery.slides);
---

<Layout
  title={homepage?.seo?.seoTitle}
  description={homepage?.seo?.seoDescription}
  image={homepage?.seo?.seoImage}
  hideHeaderUntilHeroEnd={true}
  heroSeenStorageKey={heroSeenStorageKey}
>
  <main class="h-dvh overflow-y-auto overscroll-y-contain snap-y snap-mandatory text-neutral-950">
    <HeroSlide />
    
    <section class="slide-shell snap-start" data-page-background="#EDDDD9">
      <div class="slide-panel grid grid-cols-12 items-center bg-[#EDDDD9] px-6">
        <div class="col-span-12 md:col-span-9 portable-text font-avant-garde text-2xl sm:text-3xl md:text-4xl lg:text-5xl xl:text-[3.5rem] 2xl:text-6xl text-black font-medium tracking-[-1.2px]">
          {homepage?.description && <PortableText portableText={homepage.description} />}
        </div>
      </div>
    </section>

    {slides.length ? (
      slides.map((slide) =>
        slide._type === "homepageGalleryPresentationSlide" ? (
          <HomepageIntroSlide slide={slide as PresentationSlide} />
        ) : (
          <HomepageProjectSlide slide={slide as Project} />
        ),
      )
    ) : (
      <section class="flex min-h-dvh snap-start items-center justify-center px-6" data-page-background="#EDDDD9">
        <div class="max-w-md text-center">
          <p class="text-pretty text-base text-neutral-600">
            Ajoutez deux galleries dans Sanity pour remplir la homepage.
          </p>
        </div>
      </section>
    )}

    {eventsData?.introduction && (
      <section class="slide-shell snap-start" data-page-background="#EDDDD9">
        <div class="slide-panel grid grid-cols-12 items-center bg-[#EDDDD9] px-6">
          <div class="col-span-12 md:col-span-9 portable-text font-avant-garde text-2xl sm:text-3xl md:text-4xl lg:text-5xl xl:text-[3.5rem] 2xl:text-6xl text-black font-medium tracking-[-1.2px]">
            <PortableText portableText={eventsData.introduction} />
          </div>
        </div>
      </section>
    )}

    <FooterSlide />
  </main>
</Layout>

<style>
  :global(.portable-text p) {
    margin-bottom: 20px;
  }
  :global(.portable-text p:last-child) {
    margin-bottom: 0;
  }
</style>

<script>
  import { initPageBackgroundColorSync } from "../scripts/page-backgroundcolor-sync";
  import { initProjectCardInteractions } from "../scripts/project-card-interactions";

  initProjectCardInteractions();
  initPageBackgroundColorSync();

  const deferredHeader = document.querySelector(
    '[data-hidden-until-hero-end="true"]',
  ) as HTMLElement | null;

  if (deferredHeader) {
    const revealDeferredHeader = () => {
      deferredHeader.dataset.headerVisible = "true";
      deferredHeader.classList.remove("opacity-0");
      window.removeEventListener("hero-animation-complete", revealDeferredHeader);
    };

    if (
      document.documentElement.dataset.heroSeen === "true" ||
      document.documentElement.dataset.heroAnimationComplete === "true"
    ) {
      revealDeferredHeader();
    } else {
      window.addEventListener("hero-animation-complete", revealDeferredHeader, { once: true });
    }
  }
</script>
