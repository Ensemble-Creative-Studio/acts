---
import HomepageProjectSlide from "../components/homepage/HomepageProjectSlide.astro";
import FooterSlide from "../components/homepage/FooterSlide.astro";
import PortableText from "../components/PortableText.astro";
import type { PresentationSlide, Project } from "../components/homepage/types";
import Layout from "../layouts/Layout.astro";
import { getEvents } from "../sanity/lib/sanity-utils";

const eventsData = await getEvents(Astro.locals.preview);

const galleries = eventsData?.galleries ?? [];
const slides = galleries
  .flatMap((gallery: { slides: (PresentationSlide | Project)[] }) => gallery.slides)
  .filter((slide: PresentationSlide | Project) => slide._type === "project") as Project[];
---

<Layout
  title={eventsData?.seo?.seoTitle || "Events"}
  description={eventsData?.seo?.seoDescription}
  image={eventsData?.seo?.seoImage}
>
  <main class="h-dvh overflow-y-auto overscroll-y-contain snap-y snap-mandatory text-neutral-950">
    <section class="slide-shell snap-start" data-page-background="#EDDDD9">
      <div class="slide-panel grid grid-cols-12 items-center bg-[#EDDDD9] px-6">
        <div class="col-span-12 md:col-span-9 portable-text font-avant-garde text-2xl sm:text-3xl md:text-4xl lg:text-5xl xl:text-[3.5rem] 2xl:text-6xl text-black font-medium tracking-[-1.2px]">
          {eventsData?.introduction && <PortableText portableText={eventsData.introduction} />}
        </div>
      </div>
    </section>

    {slides.length ? (
      slides.map((slide) => <HomepageProjectSlide slide={slide} />)
    ) : (
      <section
        class="flex min-h-dvh snap-start items-center justify-center px-6"
        data-page-background="#EDDDD9"
      >
        <div class="max-w-md text-center">
          <p class="text-pretty text-base text-neutral-600">
            Ajoutez une gallery dans Sanity (Events) pour remplir cette page.
          </p>
        </div>
      </section>
    )}

    <FooterSlide />
  </main>
</Layout>

<style>
  :global(.portable-text p) {
    margin-bottom: 20px;
  }
  :global(.portable-text p:last-child) {
    margin-bottom: 0;
  }
</style>

<script>
  import { initPageBackgroundColorSync } from "../scripts/page-backgroundcolor-sync";
  import {
    initProjectCardInteractions,
    initGlobalVideoMuteGuard,
  } from "../scripts/project-card-interactions";

  initProjectCardInteractions();
  initGlobalVideoMuteGuard();
  initPageBackgroundColorSync();
</script>
